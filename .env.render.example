# Render Deployment Environment Variables
# Copy this to Render dashboard as environment variables

# Django Configuration
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=your-secret-key-here  # Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_ALLOWED_HOSTS=*.onrender.com
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database (automatically set by Render when linked to PostgreSQL)
# DB_HOST
# DB_PORT
# DB_NAME
# DB_USER
# DB_PASSWORD

# CORS - Replace with your actual Vercel frontend URL
CORS_ORIGINS=https://your-app.vercel.app

# Email Configuration (optional - for enquiry notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  # Use SMTP for production
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=website@businessbrokers.com.gh
ENQUIRY_NOTIFY_EMAIL=

# Logging
LOG_LEVEL=INFO

# Google Cloud Storage (optional - only needed if not using Render)
# GS_BUCKET_NAME=
